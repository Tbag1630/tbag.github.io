{
  "advisorModel": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/ulac/paidguard.py\" mcp",
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "paidguard: checking a generation-server call"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/ulac/paidguard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" local",
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
